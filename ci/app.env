# Per-app values read by fastlane/Fastfile and the ci/ scripts. No secrets here.
APP_NAME="Block Bliss"
SCHEME="BlockBliss"
TARGETS="BlockBliss:com.gios.blockbliss"
APP_GROUP=""
THIRD_PARTY_CONTENT="false"
EXTERNAL_GROUPS="Friends"
# Built with the iOS 27.1 SDK so the iPhone Duo runs it full screen on both displays.
RUNNER="xcode-27"
XCODE="27.1"
# Engine tests and a short Monte-Carlo run (every dealt tray must be solvable); the app target has
# no XCTest bundle, so the simulator step only builds it.
PRE_TEST="swift test 2>&1 | tail -40 && swift run -c release blocksim --games 200 2>&1 | tail -40"
XCTEST="false"
